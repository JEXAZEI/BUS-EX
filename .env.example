# Public Supabase project values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. NEVER expose this to the browser or commit it.
# Used only in API routes for: admin user management, signup, login rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Domain used to build synthetic emails for student accounts (no real email required to sign up).
# Any value works as long as it's not a domain you actually control mail for.
STUDENT_EMAIL_DOMAIN=students.bus-ex.local
