# Postgres connection string for your Neon (or any Postgres 14+) database.
# Neon free tier: dashboard -> your project -> Connection Details -> "Pooled connection".
# Must include ?sslmode=require for Neon.
DATABASE_URL=postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/bus_ex?sslmode=require

# Optional: shared secret for the scheduled random-event cron endpoint
# (/api/cron/random-event). Leave unset to disable scheduled events -- the
# teacher's manual "fire event" button in /admin always works regardless.
CRON_SECRET=
